{
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.3/schema/markdownlint-cli2-config-schema.json",
    "config": {
        "line-length": false,
        "no-hard-tabs": true
    },
    "globs": [
        "**/*.md",
        "!**/node_modules",
        "!src/onionprobe/onionprobe",
        // Ignore LICENSE files, because they shouldn't be modified
        "!**/LICENSE*",
        "!**/*.license"
    ]
}
