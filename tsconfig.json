{
    "compilerOptions": {
        "target": "ES2015",
        "lib": [
            // General JS
            "ESNext",

            // Web interfaces
            "DOM",
            "DOM.iterable",

            // Asynchronicity and promises
            "ES2020.Promise",
            "ESNext.asynciterable"
        ],
        "allowJs": true,
        "checkJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "ES2022",
        "resolveJsonModule": true,
        "noEmit": true,
        "typeRoots": ["./node_modules/@types"],
        "types": ["node"],
        "importHelpers": true,
        "newLine": "lf",
        "stripInternal": true,
        "rootDir": "./src",
        "outDir": "./dist" // See also: https://stackoverflow.com/a/48798945
    },
    "include": ["./src/eslint/**/*"],
    "exclude": [
        "**/coverage/",
        "**/licenses/",
        "**/logs/",
        "**/node_modules/",
        "**/secrets/",
        "**/temp/",
        "**/tmp/",
        "**/dist/"
    ],
    "references": [
        { "path": "./src/express" },
        { "path": "./src/mongo" },
    ]
}
