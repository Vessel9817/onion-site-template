# Configuring the directory authorities of the smoke test's private Tor network

# Acting as a relay of the private network and as a version 3 authority
%include /smoke/conf/torrc-relay
AuthoritativeDirectory 1
V3AuthoritativeDirectory 1

# Voting every 20 seconds from the first round, so time periods keep one length
V3AuthVotingInterval 20 seconds
V3AuthVoteDelay 4 seconds
V3AuthDistDelay 4 seconds
TestingV3AuthInitialVotingInterval 20 seconds
TestingV3AuthInitialVoteDelay 4 seconds
TestingV3AuthInitialDistDelay 4 seconds

# Voting all relays Guard, HSDir and Stable at once, for vanguards and the onion
TestingDirAuthVoteGuard *
TestingDirAuthVoteHSDir *
AuthDirVoteStableGuaranteeMinUptime 0

# Reading bandwidths from testnet.sh's file, so every relay is Fast at once
V3BandwidthsFile /smoke/tn/bandwidth
