{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gixy release; its two checksums must be updated by hand from the release's checksums.txt",
      "managerFilePatterns": [
        "/^src/nginx/download-gixy\\.sh$/"
      ],
      "matchStrings": [
        "DEFAULT_VERSION='(?<currentValue>v[^']+)'"
      ],
      "depNameTemplate": "gixy",
      "packageNameTemplate": "dvershinin/gixy",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Docker Engine version used by CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "DOCKER_VERSION: (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "docker",
      "packageNameTemplate": "moby/moby",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^docker-(?<version>.+)$",
      "depTypeTemplate": "deps-dev"
    },
    {
      "customType": "regex",
      "description": "Docker Compose version used by CI",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "DOCKER_COMPOSE_VERSION: (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "docker/compose",
      "datasourceTemplate": "github-releases",
      "depTypeTemplate": "deps-dev"
    },
    {
      "customType": "regex",
      "description": "OnionScan commit installed with go install",
      "managerFilePatterns": [
        "/^src/onionscan/Dockerfile$/"
      ],
      "matchStrings": [
        "go install github\\.com/harr1424/onionscan@(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "onionscan",
      "packageNameTemplate": "https://github.com/harr1424/onionscan",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "markdownlint-cli2 schema version",
      "managerFilePatterns": [
        "/^src/markdownlint/\\.markdownlint-cli2\\.jsonc$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/DavidAnson/markdownlint-cli2/(?<currentValue>v\\S+)/schema/markdownlint-cli2-config-schema\\.json"
      ],
      "depNameTemplate": "DavidAnson/markdownlint-cli2",
      "datasourceTemplate": "github-tags",
      "depTypeTemplate": "deps-dev"
    },
    {
      "customType": "regex",
      "description": "Prometheus version reported to Grafana's data source, kept in step with the prom/prometheus image",
      "managerFilePatterns": [
        "/^src/grafana/datasources\\.yml$/"
      ],
      "matchStrings": [
        "prometheusVersion: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "prom/prometheus",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^v(?<version>\\d+(?:\\.\\d+){0,2})$"
    },
    {
      "customType": "regex",
      "description": "Vanguards git commit",
      "managerFilePatterns": [
        "/^src/tor/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG VANGUARDS_URL=https://github.com/mikeperry-tor/vanguards.git#(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "mikeperry-tor/vanguards",
      "packageNameTemplate": "https://github.com/mikeperry-tor/vanguards",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "postUpgradeTasks": {
        "commands": [
          "npm run workspaces:fix",
          "npm i --no-fund --no-scripts"
        ],
        "fileFilters": [
          "**/package.json",
          "**/package-lock.json"
        ],
        "installTools": {
          "node": {}
        },
        "executionMode": "branch"
      }
    },
    {
      "description": "Bump the Prometheus image and the version in Grafana's data source in one pull request",
      "matchPackageNames": [
        "prom/prometheus"
      ],
      "groupName": "prometheus"
    },
    {
      "description": "Bump markdownlint-cli2 and its schema version",
      "matchPackageNames": [
        "markdownlint-cli2",
        "DavidAnson/markdownlint-cli2"
      ],
      "groupName": "markdownlint-cli2"
    }
  ]
}
