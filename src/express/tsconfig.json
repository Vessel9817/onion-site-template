{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            // General JS
            "ESNext",

            // Web interfaces
            "DOM",
            "DOM.iterable",

            // Asynchronicity and promises
            "ES2020.Promise",
            "ESNext.asynciterable"
        ],
        "allowJs": true,
        "checkJs": true,
        "composite": true,
        "declaration": true,
        "skipLibCheck": true,
        "emitDeclarationOnly": true, // Speeds up project-wide type-checking
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "ES2022",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "noEmit": false,
        "importHelpers": true,
        "newLine": "lf",
        "stripInternal": true,
        "rootDir": ".",
        "outDir": "../../dist/src/express" // See also: https://stackoverflow.com/a/48798945
    },
    "include": ["**/*"],
    "exclude": [
        "**/coverage/",
        "**/licenses/",
        "**/logs/",
        "**/node_modules/",
        "**/secrets/",
        "**/temp/",
        "**/tmp/",
        "**/dist/"
    ]
}
