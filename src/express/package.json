{
    "name": "express_",
    "version": "0.0.0",
    "license": "MIT",
    "main": "app.ts",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vessel9817/onion-site-template.git",
        "directory": "src/express"
    },
    "homepage": "https://github.com/Vessel9817/onion-site-template#readme",
    "readme": "https://github.com/Vessel9817/onion-site-template/blob/main/README.md",
    "bugs": {
        "url": "https://github.com/Vessel9817/onion-site-template/issues"
    },
    "scripts": {
        "test": "node --import tsx --test \"./test/*.test.ts\"",
        "start": "node --env-file=./secrets/.env ./dist/index.cjs",
        "build": "node --run=build:prod",
        "build:prod": "cross-env NODE_ENV=\"production\" tsx ./webpack/index.ts",
        "build:dev": "cross-env NODE_ENV=\"development\" tsx ./webpack/index.ts",
        "tsc": "tsc --noEmit",
        "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-exclude=\"webpack/**\" --test \"./test/*.test.ts\""
    },
    "dependencies": {
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "mongodb": "^7.5.0",
        "mongoose": "^9.9.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.2.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "cross-env": "^10.1.0",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "tslib": "^2.8.1",
        "tsx": "^4.23.4",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.109.0"
    }
}
