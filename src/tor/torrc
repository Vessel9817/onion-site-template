# Exposing hidden service to tor network
HiddenServiceDir /var/lib/tor/website/

# Redirecting requests to nginx
HiddenServicePort 80 10.5.0.2:80

# Configuring Vanguards
ControlPort 10.5.3.2:9051
CookieAuthentication 1
DataDirectory /var/lib/tor/data/

# Configuring OnionBalance
CookieAuthFile /var/lib/tor/data/control_auth_cookie
CookieAuthFileGroupReadable 1
HiddenServiceOnionbalanceInstance 1

# Configuring OnionScan
SocksPort 10.5.3.2:9050

# Making sure we don't leak DNS queries
TestSocks 1

# Disabling all connections that leak DNS queries
SafeSocks 1

# Reducing fingerprintability
AvoidDiskWrites 1

# Reducing fingerprintability at the cost of bandwidth
ConnectionPadding 1
ReducedConnectionPadding 0

# Running tor with minimal privileges
User debian-tor
